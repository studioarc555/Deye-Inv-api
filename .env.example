# =========================================================================
# Deye Inverter OpenAPI & MongoDB Telemetry Service Configuration
# =========================================================================

# Server Port
PORT=4000

# Deye Cloud Developer API Credentials
DEYE_BASE_URL=https://india-developer.deyecloud.com
DEYE_APP_ID=202610155771006
DEYE_APP_SECRET=your_app_secret_here
DEYE_EMAIL=your_email@example.com
DEYE_USERNAME=your_username
DEYE_PASSWORD=your_password
DEYE_COMPANY_ID=0
DEYE_TOKEN=your_jwt_bearer_token_here

# Automated 15-Minute Sync Daemon (true to enable recurring 15-min background sync)
AUTO_SYNC_ENABLED=true

# MongoDB Atlas or Local Connection
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/myDatabase?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@atlas-emerald-branch.uhln1pi.mongodb.net/myDatabase?retryWrites=true&w=majority
MONGODB_DB_NAME=myDatabase
MONGODB_COLLECTION=ResidentialAPI
